# Banco de dados PostgreSQL (já existente no servidor)
# Formato: postgresql+asyncpg://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgresql+asyncpg://usuario:senha@localhost:5432/taskmind

# Gemini API (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ollama (LLM local - padrões abaixo geralmente funcionam)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
